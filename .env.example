# Copy to .env (git-ignored). docker compose reads it automatically.

# --- LLM: any OpenAI-compatible chat endpoint --------------------------------
# Ollama on your machine (default, free, no key):
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=

# Groq free tier:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# Gemini free tier (OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=...

# --- Retrieval models ---------------------------------------------------------
# fastembed = real local models (downloaded once, cached in the `models` volume)
# hashing   = no model at all (embedder only; offline smoke tests)
EMBEDDER=fastembed
# fastembed | none  (set none to skip the reranker and save RAM/latency)
RERANKER=fastembed
