# Copy to .env (git-ignored). docker compose reads it automatically.
# Everything here is optional: search, endpoints and the graph work with no .env at all.

# --- Where your code lives ----------------------------------------------------
# Folder mounted read-only into the container at /repos. Default: ./repos
# REPOS_DIR=C:/code

# --- LLM for /ask: any OpenAI-compatible chat endpoint ------------------------
# Option 1: Ollama on your machine (free, local, default). Install from ollama.com, then:
#   ollama pull qwen2.5-coder:7b
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=

# Option 2: Groq free tier (code is sent to Groq):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# Option 3: Gemini free tier via its OpenAI-compatible endpoint (code is sent to Google):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=...

# --- Retrieval models ---------------------------------------------------------
# fastembed = real local models (baked into the image); hashing = no model (tests only)
EMBEDDER=fastembed
# fastembed | none  (none skips the reranker: less RAM, faster, slightly worse ranking)
RERANKER=fastembed
